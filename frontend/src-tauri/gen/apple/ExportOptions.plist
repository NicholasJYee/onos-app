<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Without teamID, xcodebuild falls back to a placeholder identity
      ("Apple Distribution: Tauri (unset)") and the .ipa will not install.

      This must match DEVELOPMENT_TEAM in the Xcode project (CML5RHJMX4),
      not the team that issued the signing certificate. The Apple Development
      cert here belongs to 4A68G9PFQZ, and using that value fails with
      "No Account for Team" because the provisioning profile and app ID
      prefix are owned by CML5RHJMX4.

      The method here is for direct installs onto a registered device, which
      need a development profile. TestFlight builds override it by passing
      the CLI's export-method flag as app-store-connect; the CLI merges that
      over this file into a temporary copy, so this stays the default for
      `pnpm build:ios`. See scripts/ios-testflight.sh.
    -->
    <key>method</key>
    <string>debugging</string>
    <key>teamID</key>
    <string>CML5RHJMX4</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <key>stripSwiftSymbols</key>
    <true/>
</dict>
</plist>
