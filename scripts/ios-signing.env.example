# App Store Connect API credentials for iOS signing and upload.
#
# Copy this to scripts/ios-signing.env (which is gitignored) and fill it in.
# scripts/ios-testflight.sh sources that file automatically, so the values do
# not need to be exported in your shell every time.
#
# Create the key at App Store Connect > Users and Access > Integrations >
# App Store Connect API, with the "App Manager" role.
#
# IMPORTANT: keep the .p8 itself OUTSIDE this repository. This tree syncs to
# Synology Drive, and that key can upload builds to your App Store Connect
# account. ~/.appstoreconnect/private_keys/ is where Apple's own tools look for
# it, and the script falls back to that location if APPLE_API_KEY_PATH is unset.
# The .p8 can only be downloaded once.

# Key ID, e.g. A1B2C3D4E5 (shown in the key list)
export APPLE_API_KEY=

# Issuer ID, a UUID shown above the key list
export APPLE_API_ISSUER=

# Optional. Omit to use ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8
# export APPLE_API_KEY_PATH="$HOME/.appstoreconnect/private_keys/AuthKey_A1B2C3D4E5.p8"
